{
  "name": "blog-tutorial-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "npm run gen:api && node scripts/check-generated-header.mjs && git diff --exit-code -- src/app/api/generated/openapi-types.ts src/app/api/generated/openapi.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@angular/animations": "19.2.14",
    "@angular/common": "19.2.14",
    "@angular/compiler": "19.2.14",
    "@angular/core": "19.2.14",
    "@angular/forms": "19.2.14",
    "@angular/platform-browser": "19.2.14",
    "@angular/platform-browser-dynamic": "19.2.14",
    "@angular/router": "19.2.14",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.14",
    "@angular/cli": "19.2.14",
    "@angular/compiler-cli": "19.2.14",
    "@testing-library/angular": "17.3.6",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.15.29",
    "@typescript-eslint/eslint-plugin": "8.33.1",
    "@typescript-eslint/parser": "8.33.1",
    "@vitest/coverage-v8": "3.2.3",
    "eslint": "9.28.0",
    "jsdom": "26.1.0",
    "ajv": "8.17.1",
    "openapi-typescript": "7.8.0",
    "typescript": "5.7.3",
    "vitest": "3.2.3",
    "vite": "6.3.5",
    "@analogjs/vite-plugin-angular": "3.0.0-alpha.59"
  }
}
